# Dexie Cloud sync endpoint. Public by design — it ships inside the client bundle
# either way, and src/db/dexie.ts falls back to a baked-in default if this is unset.
VITE_DEXIE_CLOUD_SYNC_URL=https://your-database.dexie.cloud

# Overrides the local IndexedDB name. Leave this unset unless you know why you need
# it: changing the name points at a brand-new database and orphans everything already
# stored on the device. See the comment in src/db/dexie.ts.
# VITE_DEXIE_CLOUD_DATABASE_NAME=barcode-inventory-v2
